SELECT
XDATE
,XTIME
,PATIENT_ID
,COMMNOTE_TYPE
,SVCBR_ID
,PRESCRIPTION_ID
,REFILL_NO
,TEXT
FROM
THOT.CHARTS
WHERE
COMMNOTE_TYPE IN ('SC','STOP','RSNG')
AND
XDATE >= TRUNC(SYSDATE) - 30

UNION ALL

SELECT
XDATE
,XTIME
,PATIENT_ID
,COMMNOTE_TYPE
,SVCBR_ID
,PRESCRIPTION_ID
,REFILL_NO
,TEXT
FROM 
THOT.CHARTS
WHERE
COMMNOTE_TYPE = 'AUTH'
AND
TEXT LIKE '%Pending-[EPA Requested]%'
AND
XDATE >= TRUNC(SYSDATE) - 30
