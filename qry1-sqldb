,d.TASK_STATUS

,i.city
,i.state
,i.zip1
,i.sex
,i.age
,i.language_spoken
,i.charges
,i.pmt_deductions
,i.adj_deductions
,i.balance_due
,i.payments
,i.adjustments
,i.unpaid
,i.prescriptions_count
,i.sales_marketing_status
,i.pharmacy_status
,i.nursing_status
,i.csr_status
,i.collector
,i.nkda_flag
,i.SINGLE_PROFILE

,CASE WHEN a.therapy_type IN ('UPLZ','APKF','APKI','APKN','APKR','ACGL','EPDX','SUBC','BRXB','BRXD','TYRK','SABR','VIGA','STLR','STLV','BOTX') THEN 'Priority Therapy' 
WHEN i.DuplicateAcct = 'Y' THEN 'Duplicate Account'
WHEN e.intParentCaseId_fk IS NOT NULL THEN 'Previous Escalation' 
WHEN d.TASK_STS_REASON_CODE = 'CCC LIMITATION' AND d.TASK_CREATION_DATE <= DATEADD(DAY,-10,CAST(GETDATE() AS DATE)) THEN 'Unworked CCC Limitation' ELSE 'Other' END AS PTEReason

,CASE WHEN a.therapy_type IN ('UPLZ','APKF','APKI','APKN','APKR','ACGL','EPDX','SUBC','BRXB','BRXD','TYRK','SABR','VIGA','STLR','STLV','BOTX') THEN '1' 
WHEN i.DuplicateAcct = 'Y' THEN '4'
WHEN e.intParentCaseId_fk IS NOT NULL THEN '3' 
WHEN d.TASK_STS_REASON_CODE = 'CCC LIMITATION' AND d.TASK_CREATION_DATE <= DATEADD(DAY,-10,CAST(GETDATE() AS DATE)) THEN '2' ELSE '5' END AS Ranking
FROM
#Patients i
LEFT JOIN
#Rx a WITH (NOLOCK)
ON
i.ID = a.patient_id
LEFT JOIN
#EscalatedPatients b
ON
a.patient_id = b.strClientMemberNumber
AND
b.dtSubmitDateTime >= DATEADD(DAY,-14,a.next_delivery_date)
LEFT JOIN
#Calls c
ON
a.patient_id = c.correctedPatientID
AND
c.CallDate >= DATEADD(DAY,-14,a.next_delivery_date)
LEFT JOIN
#Tasks d
ON
a.patient_id = d.TASK_PATIENT_ID
AND
d.TASK_DATE >= DATEADD(DAY,-60,a.next_delivery_date)
AND
d.TASK_DATE <= a.next_delivery_date
LEFT JOIN
#EscalatedPatients e
ON
a.patient_id = e.strClientMemberNumber
AND
e.dtSubmitDateTime >= DATEADD(MONTH,-6,a.next_delivery_date)
AND
e.dtSubmitDateTime < DATEADD(DAY,-14,a.next_delivery_date)
WHERE
a.next_delivery_date >= CAST(GETDATE() AS DATE)
AND
a.next_delivery_date <= DATEADD(DAY,7,CAST(GETDATE() AS DATE))
AND
a.prescription_id IS NOT NULL
AND
d.TASK_ID IS NOT NULL
AND
b.intParentCaseId_fk IS NULL
AND
a.profile_lock_date IS NULL
AND
a.prescr_ship_date IS NULL
AND
d.TASK_STATUS NOT LIKE '%COMPLETED%'
AND
c.InteractionID IS NOT NULL
AND
CASE WHEN d.TASK_STS_REASON_CODE = 'CCC LIMITATION' AND d.TASK_CREATION_DATE <= DATEADD(DAY,-10,CAST(GETDATE() AS DATE)) THEN 5 ELSE DATEDIFF(DAY,d.TASK_CREATION_DATE,a.next_delivery_date) END BETWEEN 5 AND 30 
AND
a.patient_id NOT IN (SELECT patient_id FROM #ML WHERE prediction_date >= DATEADD(DAY,-14,CAST(GETDATE() AS DATE)))
AND
d.TASK_DESCRIPTION NOT IN ('RXP DUMMY PROFILE LOCK','RXP DUMMY ORDER ENTRY NEW REF','RXP DUMMY ORDER ENTRY RENEWALS','RXP DUMMY RX REQUEST','AR Management Task')
AND
d.WORKQUEUE_NAME NOT IN ('CLEARANCE','AUTHORIZATION')
AND
a.rx_status NOT IN ('DC','VOID')
